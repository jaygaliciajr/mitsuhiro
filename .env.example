# Copy to .env.local for development, and set the same keys in Vercel for
# preview and production. Never commit real values.

# ── Required before launch ──────────────────────────────────────────────
# The canonical origin, with no trailing slash. Until this is set the site
# serves `robots: noindex` and an empty sitemap, so an unconfigured deploy
# cannot be indexed against localhost canonical URLs.
NEXT_PUBLIC_SITE_URL=https://example.com

# ── Contact form ────────────────────────────────────────────────────────
# All three must be set for the form to appear. With any of them missing, the
# contact page shows the verified phone number instead of a form, so a message
# can never be accepted and then dropped.
#
# No public email address for Hiromitsu has been confirmed yet, so these stay
# unset until the owner supplies one.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
# Must be an address on a domain verified with the email provider.
INQUIRY_FROM_EMAIL=
